#!/usr/bin/env python3
"""Relay a coding agent's hook event (Claude Code, Codex) to jarvisd, so Jarvis can show what the agent
is doing and ask the user about its permission requests on the desktop.

  jarvis-agent-hook [--agent claude|codex]     (the hook's JSON on stdin)

Registered by `jarvis-workos agents hooks install` as a command hook. It never gets in the agent's
way: if jarvisd isn't running, the socket is wrong, or nobody answers, it exits 0 and prints nothing,
and the agent carries on exactly as without Jarvis (for a permission request, its own prompt appears).
It prints a decision only when the user allowed or denied on the desktop.

Standard library only (it starts on every hook); talks to jarvisd's owner-only socket.
"""

import json
import os
import socket
import stat
import sys

CONNECT_S = 0.3
PERMISSION_WAIT_S = 110.0
DROP = ("tool_response", "tool_output", "transcript_path", "agent_transcript_path")
MAX_STR = 2000


def clip(value, depth=0):
    if isinstance(value, str):
        return value if len(value) <= MAX_STR else value[: MAX_STR - 1] + "…"
    if isinstance(value, dict) and depth < 4:
        return {k: clip(v, depth + 1) for k, v in value.items() if k not in DROP}
    if isinstance(value, list) and depth < 4:
        return [clip(v, depth + 1) for v in value[:50]]
    return value if isinstance(value, (int, float, bool)) or value is None else str(value)[:MAX_STR]


def socket_path():
    run = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    return os.path.join(run, "jarvis-workos", "jarvisd.sock")


def main():
    agent = "claude"
    if "--agent" in sys.argv[1:]:
        i = sys.argv.index("--agent")
        agent = sys.argv[i + 1] if i + 1 < len(sys.argv) else agent
    try:
        event = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        return
    if not isinstance(event, dict):
        return
    path = socket_path()
    try:
        info = os.stat(os.path.dirname(path))
        # jarvisd's runtime dir is 0700 and ours; anything else is not our jarvisd.
        if info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) & 0o077:
            return
    except (OSError, AttributeError):
        return
    blocking = event.get("hook_event_name") == "PermissionRequest"
    try:
        conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        conn.settimeout(CONNECT_S)
        conn.connect(path)
        conn.sendall((json.dumps({"op": "agent_hook", "id": 1, "agent": agent, "event": clip(event)},
                                 ensure_ascii=False) + "\n").encode())
        conn.settimeout(PERMISSION_WAIT_S if blocking else 2.0)
        data = b""
        while not data.endswith(b"\n"):
            chunk = conn.recv(65536)
            if not chunk:
                break
            data += chunk
        conn.close()
    except (OSError, ValueError):
        return
    if not blocking:
        return
    try:
        reply = json.loads(data.decode() or "{}")
    except ValueError:
        return
    decision = reply.get("decision")
    if decision not in ("allow", "deny"):
        return
    out = {"behavior": decision}
    if decision == "deny":
        out["message"] = reply.get("message") or "Denied from Jarvis on the desktop."
    sys.stdout.write(json.dumps({"hookSpecificOutput": {"hookEventName": "PermissionRequest", "decision": out}}))


if __name__ == "__main__":
    try:
        main()
    except Exception:
        pass  # never break the agent
    sys.exit(0)
