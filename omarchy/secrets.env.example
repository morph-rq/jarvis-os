# Jarvis keys: a TEMPLATE. Never put real keys in the repository.
#
# The safest way to set a key on Omarchy (hidden prompt, stored in the desktop keyring):
#     jarvis secret set GEMINI_API_KEY
# Without a keyring, Jarvis reads ~/.config/jarvis-workos/secrets.env (it must be mode 600):
#     cp omarchy/secrets.env.example ~/.config/jarvis-workos/secrets.env
#     chmod 600 ~/.config/jarvis-workos/secrets.env      # then fill in only the lines you use
# `jarvis doctor` shows which keys are set (never their values).

# Required for the model and the Gemini Live voice (Pipecat): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Claude as the text brain or the vision fallback
ANTHROPIC_API_KEY=

# Optional: ElevenLabs (Eleven v4 Turbo) as the local engine's voice; Text to Speech access is enough (docs/VOICE.md)
ELEVENLABS_API_KEY=

# Optional: connected apps
COMPOSIO_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional: home, mail, music, calendar feeds
HOME_ASSISTANT_TOKEN=
MAIL_PASSWORD=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
CALENDAR_ICS_URLS=

# Optional: chat apps (the messaging gateway)
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
